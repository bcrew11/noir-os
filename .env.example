# NOIR server configuration (copy to .env or export before `npm start`)
NOIR_PORT=8787
NOIR_HOST=0.0.0.0
# browser | cast | external-hdmi | android-tv
NOIR_DEPLOYMENT=browser
# Use the simulated TV until a real one is paired (set 0 to disable demo TV)
NOIR_DEMO=1
# Where settings, pairings and encrypted credentials are stored
# NOIR_DATA_DIR=./data
# Translate HDMI-CEC remote presses into NOIR navigation (External HDMI mode; needs cec-utils)
NOIR_CEC=0
# Spotify (see docs/SPOTIFY.md). Client ID only — no secret needed (PKCE).
SPOTIFY_CLIENT_ID=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/api/music/spotify/callback
