{
  "name": "noir-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,tv,phone -c magenta,cyan,green \"npm:dev -w @noir/server\" \"npm:dev -w @noir/tv\" \"npm:dev -w @noir/phone\"",
    "build": "npm run build -w @noir/tv && npm run build -w @noir/phone",
    "start": "npm run start -w @noir/server",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
